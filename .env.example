# All optional. Everything else is configured in the web UI.
MCONTROLPROGRAM_ADMIN_HOST=127.0.0.1
MCONTROLPROGRAM_ADMIN_PORT=7700
MCONTROLPROGRAM_DATA_DIR=./data
# 32-byte key as hex (64 chars) or base64. If unset, data/master.key is generated on first run.
#MCONTROLPROGRAM_MASTER_KEY=
# Optional non-interactive bootstrap. If unset, the web UI shows a one-time setup page on first visit.
MCONTROLPROGRAM_ADMIN_USER=admin
#MCONTROLPROGRAM_ADMIN_PASSWORD=
# Extra plugin directories (colon separated). data/plugins/* is always scanned.
#MCONTROLPROGRAM_PLUGIN_DIRS=/opt/mcontrolprogram-plugins
# Default OAuth issuer base URL when a server has no public_url (e.g. https://mcontrolprogram.example.com)
#MCONTROLPROGRAM_PUBLIC_URL=
