"adb shell 'uiautomator dump /sdcard/ui.xml >/dev/null 2>&1; cat /sdcard/ui.xml' | python3 -c 'import sys,re; h=sys.stdin.read(); [print(m.group(1), \"|\", m.group(2)[:60], \"|\", m.group(3)) for m in re.finditer(r\\'text=\"([^\\\"]*)\\\"[^>]*resource-id=\"([^\\\"]*)\\\"[^>]*bounds=\"(\\[[^\\\"]*\\])\"\\', h) or re.finditer(r\\'text=\"([^\\\"]*)\\\"[^>]*?bounds=\"(\\[[^\\\"]*\\])\"\\', h)]' 2>/dev/null || adb shell 'cat /sdcard/ui.xml' | head -5"