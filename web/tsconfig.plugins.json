{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.plugins.tsbuildinfo",
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "@mcontrolprogram/ui": ["./src/sdk/ui.ts"],
      "@plugin/*": ["../src/plugins/*/ui/index.tsx"]
    }
  },
  "include": ["../src/plugins/*/ui"]
}
