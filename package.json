{
  "name": "mcontrolprogram",
  "version": "0.1.4",
  "description": "MControlProgram - MCP gateway with plugin architecture",
  "main": "index.js",
  "scripts": {
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "redeploy": "npm version patch --no-git-tag-version && docker compose up -d --build",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ssh": "scripts/test-sshd.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "ssh2": "^1.17.0",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
